# Скопируйте в .env.prod в корне репозитория на сервере (файл в .gitignore).
# Домен, у которого A-запись указывает на IP сервера.
DOMAIN=tropa.example.kz
# Пароль базы: только буквы и цифры (он стоит в URL), например `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Токен отдельного продакшн-бота уведомлений (docs/telegram.md); пусто — без уведомлений.
TELEGRAM_BOT_TOKEN=
# Письма с кодом подтверждения почты через resend.com; пусто — коды только в логе сервера.
RESEND_API_KEY=
# Отправитель на своём домене, проверенном в Resend (иначе Resend шлёт только владельцу аккаунта).
MAIL_FROM=Tropa <noreply@tropa.example.kz>
# 1 — без подтверждённой почты аккаунт только смотрит. Включать, когда домен проверен в Resend.
EMAIL_VERIFICATION=0
