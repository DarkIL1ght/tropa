# Скопируйте в .env.prod в корне репозитория на сервере (файл в .gitignore).
# Домен, у которого A-запись указывает на IP сервера.
DOMAIN=tropa.example.kz
# Пароль базы: только буквы и цифры (он стоит в URL), например `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Токен отдельного продакшн-бота уведомлений (docs/telegram.md); пусто — без уведомлений.
TELEGRAM_BOT_TOKEN=
