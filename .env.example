# Скопируйте в .env (он в .gitignore) и поправьте под себя.
# Локальная база: роль и база tropa, см. README.
DATABASE_URL=postgres://tropa:tropa@localhost:5432/tropa?sslmode=disable
ADDR=127.0.0.1:8080
# SECURE_COOKIES=1   # только за HTTPS-прокси
# WEATHER_URL=off     # без плашки погоды (по умолчанию — Open-Meteo)
# Уведомления в Telegram — см. docs/telegram.md. Пусто — без уведомлений.
# TELEGRAM_BOT_TOKEN=
# SITE_URL=http://127.0.0.1:8080   # адрес сайта для ссылок в сообщениях; на сервере — настоящий https-адрес
